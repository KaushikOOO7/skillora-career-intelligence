# GEMINI_API_KEY: Required for server-side Gemini AI features (Skill Extraction, Requirement Coverage).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key.
# Used on the client for Google Maps JavaScript API, Places API (New), and Advanced Markers.
# In production, restrict this key in Google Cloud Console:
# 1. Application restrictions: Set HTTP referrers to your domain(s).
# 2. API restrictions: Restrict to Maps JavaScript API, Places API (New), and Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Firebase configuration for production multi-device cloud persistence
# If not provided, Skillora operates with full local offline-first storage and guest mode.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

