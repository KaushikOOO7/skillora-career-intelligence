rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public company records (Read-only for public clients; updates restricted)
    match /companies/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // Public opportunity records (Read-only for public clients; updates restricted)
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.userId == userId
        && request.resource.data.createdAt is string;
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      // User saved target companies subcollection
      match /savedCompanies/{savedId} {
        allow read, write: if isOwner(userId);
      }

      // User application tracker subcollection
      match /applications/{appId} {
        allow read, write: if isOwner(userId);
      }

      // User opportunity alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
